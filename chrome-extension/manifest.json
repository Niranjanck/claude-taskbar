{
  "manifest_version": 3,
  "name": "Claude Taskbar Bridge",
  "version": "1.2.0",
  "description": "Reports the state of open claude.ai chats to the Claude Taskbar panel on this Mac.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
